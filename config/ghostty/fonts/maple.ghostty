# =============================================================================
# TYPOGRAPHY & FONT ENGINE: MAPLE MONO NF [MACOS RETINA BENCHMARK]
# Platform: macOS CoreText | Display: Liquid Retina XDR (Display P3)
# Shapers: HarfBuzz + CoreText 8-bit Gray Mask + GPU Metal Rasterizer
# Full Exhaustive Option Specification | Parity with Kitty 0.49.2 Architecture
#
# ── [ INSTALLATION & HOMEBREW INSTRUCTIONS ] ─────────────────────────────────
# Patched Font via Homebrew:
#   brew install --cask font-maple-mono-nf
#
# Universal Glyph / Nerd Font Symbols Fallback:
#   brew install --cask font-symbols-only-nerd-font
#
# Activation (in config.ghostty):
#   config-file = fonts/maple.ghostty
# =============================================================================

# ── [ 01 ] PRIMARY TYPEFACE ARCHITECTURE ─────────────────────────────────────
font-family             = Maple Mono NF
font-family-bold        = Maple Mono NF
font-family-italic      = Maple Mono NF
font-family-bold-italic = Maple Mono NF

font-style              = Regular
font-style-bold         = Bold
font-style-italic       = Italic
font-style-bold-italic  = Bold Italic

font-size               = 13.5

# Synthetic Styles Fallback Policy (Permit synthetic glyph derivation if face absent)
font-synthetic-style    = bold,italic,bold-italic

# OpenType Variable Font Axes & Instances (Active only for variable-axis typefaces, e.g. wght=450)
# font-variation             = wght=450
# font-variation-bold        = wght=700
# font-variation-italic      = wght=450,ital=1
# font-variation-bold-italic = wght=700,ital=1

# ── [ 02 ] TEXT SHAPING & OPENTYPE FEATURE INJECTION ─────────────────────────
# Break ligatures under active cursor during code editing
font-shaping-break      = cursor

# Core Typography & Ligatures
font-feature            = +calt
font-feature            = +zero

# Principal Disambiguation Suite (Engineering Rigor)
font-feature            = +cv01
font-feature            = +cv04
font-feature            = +cv10
font-feature            = +cv09
font-feature            = +cv62

# Pipeline & Stream Operators
font-feature            = +ss07
font-feature            = +ss08

# ── [ 03 ] RETINA RASTERIZATION & STROKE CALIBRATION ─────────────────────────
# Hardware CoreText stroke dilation (subpixel antialiasing for Liquid Retina XDR).
#
# Rendering Profiles:
#   1. Crisp Mode (Vector Precision):
#      font-thicken          = true
#      font-thicken-strength = 48    # Calibrated to Terminal.app baseline (zero blooming)
#
#   2. Neon Glow Mode (High Saturation):
#      font-thicken          = true
#      font-thicken-strength = 140   # Heavy stroke dilation for intense luminance
#
font-thicken            = true
font-thicken-strength   = 140

# FreeType Rasterizer Fallback Flags (Passive on macOS CoreText)
freetype-load-flags     = hinting,no-force-autohint,no-monochrome,autohint,light

# Grapheme Width Standard (Unicode 15.1+ Truncation & Dual-Width Normalization)
grapheme-width-method   = unicode

# ── [ 04 ] MICRO-METRICS & SUBPIXEL CELL GEOMETRY (RETINA CALIBRATION) ────────
adjust-font-baseline           = 0
# 1px cell spacing eliminates icon-to-text glyph collision in eza/git
adjust-cell-width              = 1
# 12% cell height gives clean vertical breathing room without line truncation
adjust-cell-height             = -4%

# Underline & Strikethrough Geometry (High-DPI Retina Visibility)
adjust-underline-position      = 1
adjust-underline-thickness     = 100%
adjust-strikethrough-position  = 2
adjust-strikethrough-thickness = 100%
adjust-overline-position       = 0
adjust-overline-thickness      = 100%

# Cursor & Interface Geometry
adjust-cursor-thickness        = 0
adjust-cursor-height           = 0
adjust-box-thickness           = 0
# Constrain Nerd Font icon bounding box slightly to avoid cell overflow
adjust-icon-height             = -8%


# ── [ 05 ] UNIVERSAL GLYPH ROUTING & MATHEMATICAL FALLBACKS ───────────────────
# Nerd Fonts v3.2+ PUA Range Routing:
# Use non-mono "Symbols Nerd Font" to preserve native aspect ratio & spacing,
# preventing glyphs from clipping or colliding with trailing text.
font-codepoint-map = U+23FB-U+23FE,U+2665,U+26A1,U+2B58,U+E000-U+E00A,U+E0A0-U+E0A2,U+E0A3,U+E0B0-U+E0B3,U+E0B4-U+E0C8,U+E0CA,U+E0CC-U+E0D7,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6B7,U+E700-U+E8EF,U+EA60-U+EC1E,U+ED00-U+EFCE,U+F000-U+F2FF,U+F300-U+F381,U+F400-U+F533,U+F0001-U+F1AF0=Symbols Nerd Font

# Scientific, Logic & Mathematical Symbols (STIX Two Math)
font-codepoint-map = U+2200-U+22FF,U+2A00-U+2AFF,U+27C0-U+27EF,U+2980-U+29FF,U+1D400-U+1D7FF=STIX Two Math

# Native Apple Human Interface Symbols
font-codepoint-map = U+2300-U+23FF=Apple Symbols
