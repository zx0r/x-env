# =============================================================================
# TYPOGRAPHY & FONT ENGINE: MONASPACE NEON NF [MACOS RETINA BENCHMARK]
# Platform: macOS CoreText | Display: Liquid Retina XDR (Display P3)
# Character: GitHub's variable superfamily — Neon = mechanical Neo-Grotesque
# Best for: Modern codebases, tight metrics, GitHub-native aesthetic
# Texture healing: automatic glyph width adjustment for visual balance
# =============================================================================

# ── [ 01 ] PRIMARY TYPEFACE ARCHITECTURE ─────────────────────────────────────
# MonaspiceNe = Neon variant (clean, mechanical). Alternatives installed:
# MonaspiceAr = Argon (humanist), MonaspiceRn = Radon (handwritten),
# MonaspiceKr = Krypton (serif), MonaspiceXe = Xenon (slab serif)
font-family             = MonaspiceNe Nerd Font
font-family-bold        = MonaspiceNe Nerd Font
font-family-italic      = MonaspiceRn Nerd Font
font-family-bold-italic = MonaspiceNe Nerd Font

font-style              = Regular
font-style-bold         = Bold
font-style-italic       = Italic
font-style-bold-italic  = Bold Italic

font-size               = 13.5

# Synthetic Styles Fallback Policy
font-synthetic-style    = bold-italic

# ── [ 02 ] TEXT SHAPING & OPENTYPE FEATURE INJECTION ─────────────────────────
font-shaping-break      = cursor

# OpenType Features (Monaspace texture healing + ligatures)
font-feature            = +calt
font-feature            = +zero
font-feature            = +ss01
font-feature            = +ss02
font-feature            = +ss03
font-feature            = +ss04
font-feature            = +ss05
font-feature            = +ss06
font-feature            = +ss07
font-feature            = +ss08

# ── [ 03 ] RETINA RASTERIZATION & STROKE CALIBRATION ─────────────────────────
font-thicken            = true
font-thicken-strength   = 48

# Unicode 15.1+ Width Standard
grapheme-width-method   = unicode

# ── [ 04 ] MICRO-METRICS & SUBPIXEL CELL GEOMETRY ────────────────────────────
adjust-font-baseline           = 0
adjust-cell-width              = 0
adjust-cell-height             = 10%

# Underline & Strikethrough
adjust-underline-position      = 1
adjust-underline-thickness     = 100%
adjust-strikethrough-position  = 2
adjust-strikethrough-thickness = 100%
adjust-overline-position       = 0
adjust-overline-thickness      = 100%

# Cursor & Interface
adjust-cursor-thickness        = 0
adjust-cursor-height           = 0
adjust-box-thickness           = 0
adjust-icon-height             = -6%

# ── [ 05 ] UNIVERSAL GLYPH ROUTING & FALLBACKS ───────────────────────────────
font-codepoint-map = U+23FB-U+23FE,U+2665,U+26A1,U+2B58,U+E000-U+E00A,U+E0A0-U+E0A2,U+E0A3,U+E0B0-U+E0B3,U+E0B4-U+E0C8,U+E0CA,U+E0CC-U+E0D7,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6B7,U+E700-U+E8EF,U+EA60-U+EC1E,U+ED00-U+EFCE,U+F000-U+F2FF,U+F300-U+F381,U+F400-U+F533,U+F0001-U+F1AF0=Symbols Nerd Font

# Scientific & Mathematical Symbols
font-codepoint-map = U+2200-U+22FF,U+2A00-U+2AFF,U+27C0-U+27EF,U+2980-U+29FF,U+1D400-U+1D7FF=STIX Two Math

# Apple Human Interface Symbols
font-codepoint-map = U+2300-U+23FF=Apple Symbols
