#* ┌─────────────────────────────────────────────────────────────┐
#* │ Theme: x (Cyberpunk High-Density HUD)                       │
#* │ Author: Principal Architect & Staff Systems Engineer       │
#* │ Style: Cyberpunk 2077 / Neuromancer Matrix Interface       │
#* │ Standards: Full 48-token coverage, WCAG AAA contrast ratio │
#* └─────────────────────────────────────────────────────────────┘

#* ─── Base Surface & Window Geometry ───────────────────────────
#* Main background: Abyssal Cyber-Void (deep onyx with cool navy undertone).
#* Set empty ("") if you prefer transparent terminal backdrop.
theme[main_bg]="#08090f"

#* Main typography: Frost titanium / high-legibility chrome.
theme[main_fg]="#c8d3f5"

#* Module titles: Optic white with luminous energy.
theme[title]="#ffffff"

#* Shortcut & hotkey highlights: Radioactive Amber / Neon Gold.
theme[hi_fg]="#ffe600"

#* Inactive & disabled text: Carbon slate.
theme[inactive_fg]="#3d4466"

#* Graph overlay telemetry text (uptime, bitrate scaling).
theme[graph_text]="#7e8cb6"

#* Meter background channel track.
theme[meter_bg]="#121524"

#* Box sub-divider lines & wireframe grid boundaries.
theme[div_line]="#1a1f33"


#* ─── Module Boundary Frames ──────────────────────────────────
#* CPU box outline: Electric Cyan (Neural processor matrix).
theme[cpu_box]="#00f0ff"

#* Memory & Disks box outline: Neon Violet (RAM & VRAM storage banks).
theme[mem_box]="#a855f7"

#* Network box outline: Laser Magenta (ICE Net uplink/downlink).
theme[net_box]="#ff007f"

#* Processes box outline: Toxic Acid Green (Daemon threads & scheduler).
theme[proc_box]="#00ff9f"


#* ─── Process HUD & Cursor States ─────────────────────────────
#* Active selection row: Laser Pink cursor.
theme[selected_bg]="#ff007f"

#* Active selection text: Void black for ultra-sharp >12:1 contrast.
theme[selected_fg]="#08090f"

#* Process miscellaneous accents (PID sparklines, detail graphs).
theme[proc_misc]="#00f0ff"

#* Process list pause banner background ([p] pause mode).
theme[proc_pause_bg]="#ffe600"

#* Process list follow banner background ([f] follow mode).
theme[proc_follow_bg]="#7928ca"

#* Generic process banner background.
theme[proc_banner_bg]="#ff007f"

#* Process banner foreground text (void black for crisp legibility on laser pink).
theme[proc_banner_fg]="#08090f"

#* Currently followed process row highlight background.
theme[followed_bg]="#00f0ff"

#* Currently followed process row foreground text.
theme[followed_fg]="#08090f"


#* ─── Dynamic Telemetry Gradients (Tri-Stop Spectrum) ─────────

#* CPU Load Spectrum: Sub-zero Cyan -> Kinetic Amber -> Thermal Pink/Red
theme[cpu_start]="#00f0ff"
theme[cpu_mid]="#ffe600"
theme[cpu_end]="#ff0055"

#* Silicon Thermal Spectrum: Cool Core -> Junction Warm -> Thermal Throttle
theme[temp_start]="#00e5ff"
theme[temp_mid]="#ff9e00"
theme[temp_end]="#ff0055"

#* Free Memory / Disk Space: Marine Blue -> Electric Cyan -> Toxic Mint
theme[free_start]="#0077b6"
theme[free_mid]="#00f0ff"
theme[free_end]="#00ff9f"

#* Cached Memory / Inactive Pages: Abyssal Violet -> Electric Purple -> Lavender
theme[cached_start]="#3c096c"
theme[cached_mid]="#7b2cbf"
theme[cached_end]="#c77dff"

#* Available Memory: Cold Blue Stream -> Radiant Cyan
theme[available_start]="#023e8a"
theme[available_mid]="#0096c7"
theme[available_end]="#48cae4"

#* Used Memory / Saturated Allocation: Neon Violet -> Hot Pink -> Critical Coral
theme[used_start]="#7209b7"
theme[used_mid]="#f72585"
theme[used_end]="#ff0055"

#* Network Ingress (Download): Deep Fiber Blue -> Ocean Cyan -> Blazing Electric Cyan
theme[download_start]="#03045e"
theme[download_mid]="#0077b6"
theme[download_end]="#00f0ff"

#* Network Egress (Upload): Dark Matter Violet -> Laser Orchid -> Hot Magenta
theme[upload_start]="#3a0ca3"
theme[upload_mid]="#7209b7"
theme[upload_end]="#ff007f"

#* Process Hierarchy Resource Footprint: Toxic Green -> Solar Amber -> Critical Red
theme[process_start]="#00ff9f"
theme[process_mid]="#ffe600"
theme[process_end]="#ff0055"
