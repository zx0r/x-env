# ==============================================================================
# Example Secure Enclave / FIDO2 Public Key Stub
# ==============================================================================
#
# HOW TO EXPORT & COPY YOUR PUBLIC KEY:
#
# Option A: From Apple Secure Enclave (Secretive.app) via CLI
#   ssh-add -L | grep ecdsa-sha2-nistp256 > ~/.ssh/identities/id_ecdsa-sha2-nistp256@github.pub
#
# Option B: From Apple Secure Enclave (Secretive.app) via GUI
#   1. Open Secretive.app
#   2. Select your signing / auth key in the list
#   3. Click "Copy Public Key"
#   4. Paste into ~/.ssh/identities/<name>_<keytype>@<provider>.pub
#
# Option C: From FIDO2 / YubiKey Hardware Token
#   ssh-keygen -K
#   mv id_ecdsa_sk.pub ~/.ssh/identities/id_sk-ecdsa@github.pub
#
# Option D: From an existing private key (Software Fallback)
#   ssh-keygen -y -f ~/.ssh/id_ed25519 > ~/.ssh/identities/id_ed25519@github.pub
#
# ENFORCE FILE PERMISSIONS:
#   chmod 0700 ~/.ssh/identities
#   chmod 0600 ~/.ssh/identities/*.pub
#
# FORMAT SPECIFICATION:
# <key-type> <base64-encoded-key> <principal-or-comment>
ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBNwI22B99xrTEoyGWFAlN9QaWWxKjMHozOhx74ZGhuhMLPg0FqVMnHpfZxISOaAQm66fkznGnY2ljwVH120DrPc= user@example.com
