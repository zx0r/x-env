# NOTE:-------------------------------------------------------
#   ██╗  ██╗    W O R K S T A T I O N
#   ╚██╗██╔╝
#    ╚███╔╝     SYSTEMS OVER SCRIPTS
#    ██╔██╗     INTENT OVER DRIFT
#   ██╔╝ ██╗    AUTOMATION WITH CONTROL
#   ╚═╝  ╚═╝
# OpenSSH Monolithic Architecture Reference
# Platform : macOS Sequoia (Apple Silicon arm64 Darwin 25+)
# Standards: OpenSSH 10.5+ | FIPS 203 (ML-KEM) | RFC 5647 | ANSSI DAT-NT-007 | BSI TR-02102-4
# Hardware : Apple Silicon Secure Enclave (Secretive Touch ID)
# Path     : ~/.ssh/config.monolithic.example
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Global parser compatibility directives
IgnoreUnknown UseKeychain

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. SPECIFIC HOST DIRECTIVES (FIRST-MATCH-WINS PRECEDENCE)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# GitHub Standard Git Transport (Port 22)
Host github.com gist.github.com
    User git
    HostName github.com
    Port 22
    IdentityFile ~/.ssh/zx0r_ecdsa-sha2-nistp256@github.pub
    IdentitiesOnly yes
    AddKeysToAgent no
    UseKeychain yes
    PreferredAuthentications publickey

# GitHub Alternate Transport (Port 443 - Firewall / Proxy Evasion)
# Essential for corporate networks, hotels, and restrictive firewalls blocking Port 22
Host ssh.github.com *.ssh.github.com 443.github.com *.443.github.com
    User git
    HostName ssh.github.com
    Port 443
    IdentityFile ~/.ssh/zx0r_ecdsa-sha2-nistp256@github.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey

# Alias: github-443 — Explicit Port 443 Git Remote
# Usage: git remote set-url origin github-443:username/repo.git
Host github-443
    User git
    HostName ssh.github.com
    Port 443
    IdentityFile ~/.ssh/zx0r_ecdsa-sha2-nistp256@github.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey

# Local Infrastructure Gateway
Host openwrt openwrt.lan
    HostName openwrt.lan
    User root
    Port 22
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 2. GLOBAL DEFAULTS & DEFENSE-IN-DEPTH HARDENING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Host *
    # Apple Secure Enclave Hardware Agent Socket Routing:
    # Routes through the dynamic symlink ~/.ssh/ssh_auth_sock maintained by
    # 11-identity-agent.fish. Falls back dynamically during inbound SSH or tmux.
    IdentityAgent ~/.ssh/ssh_auth_sock

    # Strict Identity Gating: Only present keys explicitly configured per host
    IdentitiesOnly yes
    AddKeysToAgent no
    ForwardAgent no
    UseKeychain yes

    # Authentication Constraints: Enforce Public Key Authentication
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes

    # Host Verification & Anti-Reconnaissance
    StrictHostKeyChecking ask
    HashKnownHosts yes
    VerifyHostKeyDNS yes
    VisualHostKey yes

    # Network Transport Architecture & Dual-Stack Resilience
    AddressFamily any
    ConnectTimeout 10

    # Side-Channel Timing Defense (OpenSSH 9.5+)
    ObscureKeystrokeTiming yes

    # Forward Secrecy & Cryptographic Session Hygiene
    # Forces session rekeying after 1 GB of data or 1 hour
    RekeyLimit 1G 1h

    # Channel Lockdown & Anti-Leakage
    Compression no
    ForwardX11 no
    ForwardX11Trusted no
    ClearAllForwardings yes
    PermitLocalCommand no
    LogLevel INFO

    # Channel Multiplexing (Darwin XNU 104-byte Safe Hash Path)
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/cm-%C

    # Channel Inactivity & Multiplexing Garbage Collection (OpenSSH 9.2+)
    ChannelTimeout session=15m direct-tcpip=30m

    # Connection Liveness & Network Resilience
    ServerAliveInterval 15
    ServerAliveCountMax 3
    TCPKeepAlive yes

    # IP Quality of Service
    IPQoS lowdelay throughput

    # 1. Key Exchange Algorithms (KEX):
    # Post-Quantum Hybrid ML-KEM-768 (FIPS 203) prioritized over classical ECDH
    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512

    # 2. Symmetric Ciphers (AEAD):
    # AES-GCM prioritized over ChaCha20 for Terrapin immunity (RFC 5647 §7.1 / arXiv:2609.26358)
    # Hardware-accelerated via Apple Silicon ARMv8.5-A Crypto Extensions (AES/PMULL)
    # AES-CTR retained for ANSSI DAT-NT-007 compliance
    Ciphers aes256-gcm@openssh.com,aes128-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-ctr,aes128-ctr

    # 3. Message Authentication Codes (MACs):
    # Encrypt-then-MAC (EtM) mitigates padding oracle vulnerabilities
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

    # 4. Host Key Verification Algorithms:
    # Modern Ed25519, Post-Quantum ML-DSA (FIPS 204), FIDO2 Hardware Keys, and RFC 8332 RSA-SHA2
    HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-mldsa44-ed25519@openssh.com,ssh-mldsa44-ed25519-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521,sk-ecdsa-sha2-nistp256@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256

    # 5. Public Key Accepted Signature Algorithms:
    PubkeyAcceptedAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-mldsa44-ed25519@openssh.com,ssh-mldsa44-ed25519-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521,sk-ecdsa-sha2-nistp256@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256
