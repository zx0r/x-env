# NOTE:-------------------------------------------------------
#   ██╗  ██╗    W O R K S T A T I O N
#   ╚██╗██╔╝
#    ╚███╔╝     SYSTEMS OVER SCRIPTS
#    ██╔██╗     INTENT OVER DRIFT
#   ██╔╝ ██╗    AUTOMATION WITH CONTROL
#   ╚═╝  ╚═╝
# OpenSSH Monolithic Architecture Reference
# Platform : macOS Sequoia (Apple Silicon arm64 Darwin 25+)
# Standards: OpenSSH 10.5+ | RFC 4251-4254 | RFC 8308 | RFC 8332 | FIPS 203 (ML-KEM) | RFC 5647
# Hardware : Apple Secure Enclave (Secretive Touch ID Hardware Key)
# Path     : ~/.ssh/config.monolithic.example
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Global parser compatibility directives (Apple Darwin platform extensions)
IgnoreUnknown UseKeychain,AppleMultipath

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. SPECIFIC HOST DIRECTIVES (FIRST-MATCH-WINS PRECEDENCE — Zone 01-79)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Standard GitHub Git Transport (Port 22)
Host github.com gist.github.com
    User git
    Port 22
    HostName github.com
    AddKeysToAgent no
    IdentitiesOnly yes
    IdentityFile ~/.ssh/identities/zx0r_ecdsa-sha2-nistp256@github.pub
    PreferredAuthentications publickey
    VerifyHostKeyDNS no
    ObscureKeystrokeTiming no

# GitHub Alternate SSH Transport (Port 443 - Firewall / Proxy Evasion)
# Essential for corporate networks, hotels, and restrictive firewalls blocking Port 22
Host ssh.github.com *.ssh.github.com 443.github.com *.443.github.com
    User git
    Port 443
    HostName ssh.github.com
    IdentitiesOnly yes
    IdentityFile ~/.ssh/identities/zx0r_ecdsa-sha2-nistp256@github.pub
    PreferredAuthentications publickey
    VerifyHostKeyDNS no
    ObscureKeystrokeTiming no

# Alias: github-443 — Explicit Port 443 Git Remote
# Usage: git remote set-url origin github-443:username/repo.git
Host github-443
    User git
    Port 443
    HostName ssh.github.com
    IdentitiesOnly yes
    IdentityFile ~/.ssh/identities/zx0r_ecdsa-sha2-nistp256@github.pub
    PreferredAuthentications publickey
    VerifyHostKeyDNS no
    ObscureKeystrokeTiming no

# Local Network Gateway / OpenWrt Router (Hardened Port 22222)
Host openwrt openwrt.lan
    User root
    Port 22222
    HostName openwrt.lan
    IdentitiesOnly yes
    IdentityFile ~/.ssh/identities/zx0r_ecdsa-sha2-nistp256@github.pub
    PreferredAuthentications publickey
    StrictHostKeyChecking accept-new
    ServerAliveInterval 10
    ServerAliveCountMax 2
    Compression no

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 2. GLOBAL DEFAULTS & PROTOCOL DOMAINS (Zone 80-99)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Host *
    # --- Authentication Protocol Domain (RFC 4252 / Zone 85-89) ---
    IdentityAgent SSH_AUTH_SOCK
    IdentitiesOnly yes
    AddKeysToAgent no
    PubkeyAuthentication yes
    PasswordAuthentication no
    HostbasedAuthentication no
    KbdInteractiveAuthentication no

    # --- Connection Protocol Domain (RFC 4254 / Zone 80-84) ---
    AppleMultipath yes
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/sockets/%C
    ChannelTimeout session=15m direct-tcpip=30m forwarded-tcpip=30m
    TCPKeepAlive yes
    ConnectionAttempts 3
    ServerAliveInterval 15
    ServerAliveCountMax 3
    Tunnel no
    ForwardX11 no
    ForwardAgent no
    ForwardX11Trusted no
    PermitLocalCommand no
    ClearAllForwardings yes
    ExitOnForwardFailure yes
    PermitRemoteOpen none
    SendEnv -LANG -LC_*
    IPQoS none

    # --- Transport Layer Protocol Domain (RFC 4253 / Zone 90-99) ---
    VisualHostKey yes
    HashKnownHosts yes
    VerifyHostKeyDNS yes
    StrictHostKeyChecking ask
    UpdateHostKeys yes
    WarnWeakCrypto yes
    RequiredRSASize 4096
    LogLevel INFO
    Compression no
    AddressFamily any
    ConnectTimeout 10
    ObscureKeystrokeTiming yes
    RekeyLimit 1G 1h

    # 1. Key Exchange Algorithms (KEX)
    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512

    # 2. Symmetric Ciphers (AEAD)
    Ciphers aes256-gcm@openssh.com,aes128-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-ctr,aes128-ctr

    # 3. Message Authentication Codes (MACs)
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

    # 4. Host Key Verification Algorithms
    HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-mldsa44-ed25519@openssh.com,ssh-mldsa44-ed25519-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521,sk-ecdsa-sha2-nistp256@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256

    # 5. Public Key Accepted Signature Algorithms
    PubkeyAcceptedAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-mldsa44-ed25519@openssh.com,ssh-mldsa44-ed25519-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521,sk-ecdsa-sha2-nistp256@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256

    # 6. Certificate Authority Signature Algorithms
    CASignatureAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,ecdsa-sha2-nistp256,sk-ecdsa-sha2-nistp256@openssh.com,rsa-sha2-512,rsa-sha2-256
