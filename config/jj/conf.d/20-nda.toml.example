#   ██╗  ██╗    W O R K S T A T I O N
#   ╚██╗██╔╝
#    ╚███╔╝     SYSTEMS OVER SCRIPTS
#    ██╔██╗     INTENT OVER DRIFT
#   ██╔╝ ██╗    AUTOMATION WITH CONTROL
#   ╚═╝  ╚═╝
# Jujutsu Profile Template: NDA / Commercial / Client Projects (~/x/dev/nda)
# Copy this file to 20-nda.toml and fill in your corporate/client values:
#   cp 20-nda.toml.example 20-nda.toml
# Platform : macOS 27+ (Apple Silicon arm64 Darwin)
# Standard : OpenSSH PROTOCOL.sshsig / Secure Enclave (Touch ID)
# ==============================================================================

[user]
name = "<your-full-name>"
email = "<your-work-or-client-email@company.com>"

[signing]
behavior = "own"
backend = "ssh"
key = "~/.ssh/<your-client-or-hardware-signing-key>.pub"
backends.ssh.program = "/usr/bin/ssh-keygen"
