# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   ██╗  ██╗    W O R K S T A T I O N
#   ╚██╗██╔╝
#    ╚███╔╝     SYSTEMS OVER SCRIPTS
#    ██╔██╗     INTENT OVER DRIFT
#   ██╔╝ ██╗    AUTOMATION WITH CONTROL
#   ╚═╝  ╚═╝
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Light Palette - x.tmux

# --- Core ---
set -ogq @ui_bg         "#f5f5f7"
set -ogq @ui_fg         "#1c1c2c"
set -ogq @ui_black      "#000000"

# --- Text Hierarchy ---
set -ogq @ui_fg_muted   "#7b8496"
set -ogq @ui_fg_subtle  "#acacac"

# --- Surfaces ---
set -ogq @ui_surface    "#eaeaea"
set -ogq @ui_overlay    "#acacac"

# --- Semantic ---
set -ogq @ui_accent     "#008c99"
set -ogq @ui_accent_alt "#d100bf"
set -ogq @ui_success    "#008b0c"
set -ogq @ui_error      "#d11500"
set -ogq @ui_warning    "#997b00"
set -ogq @ui_info       "#0057d1"

# --- Interactive ---
set -ogq @ui_highlight  "#d17c00"
set -ogq @ui_selection  "#F28534"
set -ogq @ui_pink       "#f40064"
set -ogq @ui_lavender   "#a018ff"

# --- Border Accents ---
set -ogq @ui_border_1        "#008c99"
set -ogq @ui_border_2        "#d100bf"
set -ogq @ui_border_3        "#a018ff"
set -ogq @ui_border_active   "#008c99"

# --- Compat (binds.conf popup) ---
set -ogq @base00 "default"
