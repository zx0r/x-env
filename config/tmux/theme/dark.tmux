# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   ██╗  ██╗    W O R K S T A T I O N
#   ╚██╗██╔╝
#    ╚███╔╝     SYSTEMS OVER SCRIPTS
#    ██╔██╗     INTENT OVER DRIFT
#   ██╔╝ ██╗    AUTOMATION WITH CONTROL
#   ╚═╝  ╚═╝
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Dark Palette - x.tmux

# --- Core ---
set -gq @ui_bg         "default"
set -gq @ui_fg         "#bcc4dd"
set -gq @ui_black      "#000000"

# --- Text Hierarchy ---
set -gq @ui_fg_muted   "#7b8496"
set -gq @ui_fg_subtle  "#3c4048"
set -gq @ui_graphite   "#4A5168"
set -gq @ui_dim        "#646B84"

# --- Surfaces ---
set -gq @ui_surface    "#0d0f14"
set -gq @ui_overlay    "#3c4048"

# --- Semantic ---
set -gq @ui_accent     "#bd5eff"
set -gq @ui_accent_alt "#ff5ef1"
set -gq @ui_success    "#5eff6c"
set -gq @ui_error      "#ff6e5e"
set -gq @ui_warning    "#f1ff5e"
set -gq @ui_info       "#5ea1ff"

# --- Interactive ---
set -gq @ui_highlight  "#ffbd5e"
set -gq @ui_selection  "#F28534"
set -gq @ui_pink       "#ff5ea0"
set -gq @ui_lavender   "#bd5eff"

# --- Border Accents ---
set -gq @ui_border_1        "#5ef1ff"
set -gq @ui_border_2        "#ff5ef1"
set -gq @ui_border_3        "#bd5eff"
set -gq @ui_border_active   "#5ef1ff"

# --- Compat (binds.conf popup) ---
set -gq @base00 "default"
