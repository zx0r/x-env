# Dark Palette — Cyberdream

# --- Core ---
set -ogq @ui_bg         "#16181a"
set -ogq @ui_fg         "#ffffff"
set -ogq @ui_black      "#000000"

# --- Text Hierarchy ---
set -ogq @ui_fg_muted   "#7b8496"
set -ogq @ui_fg_subtle  "#3c4048"

# --- Surfaces ---
set -ogq @ui_surface    "#1e2124"
set -ogq @ui_overlay    "#3c4048"

# --- Semantic ---
set -ogq @ui_accent     "#5ef1ff"
set -ogq @ui_accent_alt "#ff5ef1"
set -ogq @ui_success    "#5eff6c"
set -ogq @ui_error      "#ff6e5e"
set -ogq @ui_warning    "#f1ff5e"
set -ogq @ui_info       "#5ea1ff"

# --- Interactive ---
set -ogq @ui_highlight  "#ffbd5e"
set -ogq @ui_selection  "#F28534"
set -ogq @ui_pink       "#ff5ea0"
set -ogq @ui_lavender   "#bd5eff"

# --- Compat (binds.conf popup) ---
set -ogq @base00 "default"
