<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.macos-security.pfctl</string>
    <key>ProgramArguments</key>
    <array>
        <string>/sbin/pfctl</string>
        <string>-E</string>
        <string>-a</string>
        <string>local.macos-security</string>
        <string>-f</string>
        <string>/etc/pf.anchors/local.macos-security</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>LaunchOnlyOnce</key>
    <true/>
    <key>ProcessType</key>
    <string>System</string>
    <key>StandardOutPath</key>
    <string>/var/log/macos-security.pfctl.out</string>
    <key>StandardErrorPath</key>
    <string>/var/log/macos-security.pfctl.err</string>
</dict>
</plist>
