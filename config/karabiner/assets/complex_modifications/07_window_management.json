{
    "title": "07 - Raycast Window Management & Multi-Display Orchestration",
    "rules": [
        {
            "description": "Hyper + Window Management: Left/Right Half, Maximize, Center, Multi-Display hopping",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "left_arrow",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'raycast://extensions/raycast/window-management/previous-display'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_arrow",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'raycast://extensions/raycast/window-management/next-display'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "up_arrow",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'raycast://extensions/raycast/window-management/almost-maximize'"
                        }
