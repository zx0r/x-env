                                { "product_id": 64007, "vendor_id": 13652 }
                            ]
                        }
                    ],
                    "from": {
                        "key_code": "f1",
                        "modifiers": { "mandatory": ["fn"], "optional": ["any"] }
                    },
                    "to": [{ "shell_command": "open ~" }]
