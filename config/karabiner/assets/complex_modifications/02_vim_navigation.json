                    "type": "basic",
                    "from": {
                        "key_code": "k",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [{ "key_code": "up_arrow", "modifiers": ["left_shift"] }]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "l",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [{ "key_code": "right_arrow", "modifiers": ["left_shift"] }]
