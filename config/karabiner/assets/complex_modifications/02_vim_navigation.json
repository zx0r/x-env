{
    "title": "02 - Vim Modal Navigation & Selection",
    "rules": [
        {
            "description": "Hyper + Vim Navigation: H/J/K/L (Arrows), W/B (Word), 0/$ (Line), U/D (Page), I/O (Doc)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "h",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [{ "key_code": "left_arrow", "modifiers": ["left_shift"] }]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "j",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [{ "key_code": "down_arrow", "modifiers": ["left_shift"] }]
