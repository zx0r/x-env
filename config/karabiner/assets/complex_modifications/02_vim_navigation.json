                        "key_code": "w",
                        "modifiers": {
                            "mandatory": ["left_command", "left_control", "left_option", "left_shift", "right_shift"]
                        }
                    },
                    "to": [{ "key_code": "right_arrow", "modifiers": ["left_shift", "left_option"] }]
