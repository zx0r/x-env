{
    "title": "05 - System Safety & Accidental Quit Protection",
    "rules": [
        {
            "description": "Hold Command+Q for 600ms to Quit Application (Swallows Accidental Taps)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "q",
                        "modifiers": {
                            "mandatory": [
                                "command"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [],
                    "to_if_held_down": [
                        {
                            "key_code": "q",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ],
                    "parameters": {
                        "basic.to_if_held_down_threshold_milliseconds": 600
                    }
                }
            ]
        }
    ]
}
