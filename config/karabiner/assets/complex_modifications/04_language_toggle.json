{
    "title": "04 - Language Switching Ergonomics",
    "rules": [
        {
            "description": "Right Shift / Right Control: Tap alone for Language Switch (Ctrl+Space), Hold for Modifier",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_shift",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "right_shift"
                        }
                    ],
                    "to_if_alone": [
                        {
                            "key_code": "spacebar",
                            "modifiers": [
                                "left_control"
                            ]
                        }
                    ],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 250
                    }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_control",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "right_control"
                        }
                    ],
                    "to_if_alone": [
                        {
                            "key_code": "spacebar",
                            "modifiers": [
                                "left_control"
                            ]
                        }
                    ],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 250
                    }
                }
            ]
        }
    ]
}
