# ripgrep configuration (ripgreprc)
# Specification: XDG Base Directory (~/.config/ripgrep/ripgreprc)
# Active Environment: RIPGREP_CONFIG_PATH=/Users/x0r/.config/ripgrep/ripgreprc
# Engine: ripgrep 15+ (Rust DFA regex + PCRE2 JIT + Apple Silicon NEON SIMD)
# ------------------------------------------------------------------------------

# Search Mechanics
--smart-case
--hidden
--line-number
--engine=auto

# Output Constraints & Formatting
--max-columns=400
--max-columns-preview
--hyperlink-format=default

# Color Specifications (24-bit TrueColor)
--color=auto
--colors=path:fg:0x8B,0xE9,0xFD
--colors=path:style:bold
--colors=line:fg:0x62,0x72,0xA4
--colors=line:style:nobold
--colors=column:fg:0xBD,0x93,0xF9
--colors=column:style:bold
--colors=match:fg:0x50,0xFA,0x7B
--colors=match:style:bold

# File Type Extensions
--type-add=web:*.{html,css,scss,sass,less,js,jsx,ts,tsx,vue,svelte}*
--type-add=csv:*.{csv,tsv}
--type-add=pyi:*.pyi
--type-add=hx:*.hx
--type-add=lock:*.{lock,lockb}
--type-add=config:*.{json,yaml,yml,toml,ron,ini,env}*

# Boundary Safety
# Prevent descending into internal VCS metadata when --hidden is active
--glob=!.git/*

# Global Ignore Engine
# Uses ripgrep's compiled Gitignore Aho-Corasick/trie matcher
--ignore-file=/Users/x0r/.config/ripgrep/ripgrep_ignore
