<dict>
    <key>name</key>
    <string>x</string>
    <key>author</key>
    <string>zx0r &amp; DeepMind Advanced Agentic Systems</string>
    <key>colorSpaceName</key>
    <string>sRGB</string>
    <key>semanticClass</key>
    <string>theme.dark.x</string>
    <key>settings</key>
    <array>
        <!-- ================================================================= -->
        <!-- Core Editor & Gutter Settings (Cyberpunk 2077 Palette)             -->
        <!-- ================================================================= -->
        <dict>
            <key>settings</key>
            <dict>
                <!-- Terminal Transparency: Void (#00000000) inherits terminal surface -->
                <key>background</key>
                <string>#00000000</string>
                <key>foreground</key>
                <string>#D1E8F2</string>
                <key>caret</key>
                <string>#00F0FF</string>
                <key>selection</key>
                <string>#1E1F35</string>
                <key>selectionForeground</key>
                <string>#00F0FF</string>
                <key>lineHighlight</key>
                <string>#151624</string>
                <key>invisibles</key>
                <string>#363952</string>
                <key>gutter</key>
                <string>#00000000</string>
                <key>gutterForeground</key>
                <string>#464D67</string>
                <key>guide</key>
                <string>#2D324D</string>
                <key>activeGuide</key>
                <string>#00F0FF</string>
                <key>findHighlight</key>
                <string>#FFE600</string>
                <key>findHighlightForeground</key>
                <string>#000000</string>
            </dict>
        </dict>

        <!-- ================================================================= -->
        <!-- Comments & Documentation (Muted Cyber Slate)                      -->
        <!-- ================================================================= -->
