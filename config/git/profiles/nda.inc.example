# ==============================================================
#   ██╗  ██╗    W O R K S T A T I O N
#   ╚██╗██╔╝
#    ╚███╔╝     SYSTEMS OVER SCRIPTS
#    ██╔██╗     INTENT OVER DRIFT
#   ██╔╝ ██╗    AUTOMATION WITH CONTROL
#   ╚═╝  ╚═╝
# Git Profile Template: NDA / Commercial / Client Projects (~/x/dev/nda)
# Copy this file to nda.inc and fill in your corporate/client values:
#   cp nda.inc.example nda.inc
# ==============================================================
[user]
    name = <your-full-name>
    email = <your-work-or-client-email@company.com>
    signingkey = ~/.ssh/<your-client-or-hardware-signing-key>.pub

[commit]
    gpgsign = true

[tag]
    gpgSign = true
    forceSignAnnotated = true
